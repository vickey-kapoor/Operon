# ── Model keys ───────────────────────────────────────────────────────────────
# GEMINI_API_KEY is required: Gemini is Operon's model for browser and desktop runs.
# Gemini API key (get one at https://aistudio.google.com/apikey). It runs the default
# browser and desktop backends (Gemini computer use). GOOGLE_API_KEY is accepted as a fallback name
# (GEMINI_API_KEY takes precedence).
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# An optional per-user file, <OPERON_CONFIG_DIR>/operon.env (default ~/.operon), can also hold
# the key; every `operon` command reads it after this .env, and a value set here wins.
# OPERON_CONFIG_DIR=

# ── Other models, side by side with Gemini (KAN-168) ─────────────────────────────
# Experimental, off unless OPERON_BROWSER_BACKEND / OPERON_DESKTOP_BACKEND is "model". The
# profile (a key of src/operon/agent/backends/model_adapter/models.yaml, e.g. claude-sonnet-5-5 or openai-computer-use) picks
# the model; the run is thin and the model's own "done" ends it. The batch's
# `model=<profile>` cell word sets both for one cell. Gemini stays the default.
# OPERON_MODEL_PROFILE=
# OPERON_MODEL_REGISTRY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1/messages
# OPERON_CLAUDE_ZOOM=false
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=

# ── Auth & Security ───────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for the X-API-Key header.
#
# Unset = the server generates one key on first start and keeps it in
# .var/api-key (under OPERON_RUNTIME_ROOT). The benchmark harness reads
# that file, so local use needs no setup.
# API_KEYS=your-key-1,your-key-2
API_KEYS=

# Turn authentication off (only when API_KEYS is unset). This API can drive a
# real browser and a real desktop, so use it only on a throwaway machine.
OPERON_ALLOW_UNAUTHENTICATED=false

# Comma-separated list of allowed CORS origins (exact scheme://host:port). Empty = no
# origins allowed. Also gates browser connections to /ws/stream (any other Origin is
# refused; clients that send no Origin, and loopback same-origin pages, are allowed).
# Example: CORS_ORIGINS=http://localhost:3000,https://myapp.com
CORS_ORIGINS=

# Extra host names this API answers to, comma-separated. Loopback names
# (localhost, 127.0.0.1, ::1) are always allowed; a request for any other Host is
# refused with 400, which stops web pages from reaching the API by DNS rebinding.
# Example: OPERON_ALLOWED_HOSTS=operon.internal
OPERON_ALLOWED_HOSTS=

# ── Browser ───────────────────────────────────────────────────────────────────
# Run Chromium headless. The code default (and docs/configuration.md) is false: the
# browser window is shown. This file lists false so copying it changes nothing; set
# "true" for servers and CI, which have no display.
BROWSER_HEADLESS=false
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# ── Persistence ───────────────────────────────────────────────────────────────
# Local generated artifact roots. Leave unset to use the defaults: .var/... in a
# source checkout, the per-user folder (OPERON_CONFIG_DIR, ~/.operon) for a pip install.
# OPERON_RUNTIME_ROOT=.var
# OPERON_RUNS_ROOT=.var/runs
# OPERON_BROWSER_ARTIFACTS_ROOT=.var/browser-artifacts
# OPERON_DESKTOP_ARTIFACTS_ROOT=.var/desktop-artifacts
# OPERON_TEST_ARTIFACTS_ROOT=.var/test-artifacts
# Days of run directories kept by the startup retention sweep; -1 disables it.
# OPERON_RUNS_RETAIN_DAYS=14

# ── Vertex AI (optional — alternative to a Gemini API key) ───────────────────
# Set OPERON_USE_VERTEX=true to use Application Default Credentials instead.
# OPERON_USE_VERTEX=false
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# ── Model selection ───────────────────────────────────────────────────────────
# Gemini is Operon's only model. Every model setting below defaults to gemini-3.5-flash,
# which has computer use built in.
# Global Gemini model default (used when no mode-specific model is set).
GEMINI_MODEL=gemini-3.5-flash

# Desktop loop — backend: computer_use (Gemini computer use, the default) | model (see OPERON_MODEL_PROFILE)
OPERON_DESKTOP_BACKEND=computer_use
# Desktop model (unset = gemini-3.5-flash), with this Gemini 3 thinking level
# (minimal | low | medium | high; ignored on Gemini 2.x; empty = model default).
# OPERON_DESKTOP_MODEL=gemini-3.5-flash
# OPERON_DESKTOP_THINKING=low
# Desktop platform: windows (the default) | linux (an X11 desktop, e.g. the Azure Linux VM,
# KAN-108: Linux app catalog and prompt, and the API streams the screen and takes
# the person's input during a takeover).
# OPERON_DESKTOP_PLATFORM=windows
# Where desktop runs happen (KAN-80; `operon envs` lists them): live (the default, this
# machine's own screen) | windows-sandbox (a clean, throwaway Windows Sandbox on this PC)
# | linux-container (a Linux XFCE desktop in Docker; needs Docker Desktop running).
# OPERON_ENVIRONMENT=live
# Windows Sandbox: memory for the sandbox, and how long to wait for it to start.
# OPERON_SANDBOX_MEMORY_MB=4096
# OPERON_SANDBOX_START_TIMEOUT=240
# Linux container: a prebuilt image to use instead of building docker/linux-desktop (the
# first start builds it, a few minutes); seconds to wait for it; a CA bundle for pip during
# the build when a TLS-inspecting proxy sits in between.
# OPERON_CONTAINER_IMAGE=
# OPERON_CONTAINER_START_TIMEOUT=120
# OPERON_CONTAINER_CA_BUNDLE=
# OSWorld benchmark (KAN-169): the task VM's server, with OPERON_ENVIRONMENT=osworld.
# OPERON_OSWORLD_URL=
# OSWorld executor: seconds to wait after each input action or app launch (once per batch, also a part-failed one) before the next screenshot (0 = off, max 10).
# OPERON_OSWORLD_POST_ACTION_WAIT_S=0
# Inside a run environment only: the one-time token `operon guest` requires (the provider
# sets it, or passes --token-file). Never set this on the host.
# OPERON_GUEST_TOKEN=

# `operon cloud` (KAN-108): Operon's own computer on an Azure Linux VM, run from your PC.
# OPERON_CLOUD_RESOURCE_GROUP=operon-bench
# OPERON_CLOUD_VM=operon-linux
# OPERON_CLOUD_LOCATION=westus2
# OPERON_CLOUD_SIZE=Standard_D2s_v4
# OPERON_CLOUD_ADMIN=azureuser
# OPERON_CLOUD_LOCAL_PORT=8090

# Browser loop — backend: computer_use (Gemini computer use, the default) | model (see OPERON_MODEL_PROFILE)
# OPERON_BROWSER_BACKEND=computer_use
OPERON_BROWSER_MODEL=gemini-3.5-flash
# Thinking: a level (minimal, low, high) on Gemini 3, a token budget (0 = off) on Gemini 2.5; empty = model default
OPERON_BROWSER_THINKING=low

# There is one harness: the model's actions run as chosen with no rules or retries in
# between, failures go back to the model as tool results, and there is no per-step
# verifier; the model's own "done" ends the run (the benchmark graders decide). Safety
# gates stay on. The Full harness and its json backends were removed (KAN-183), along with
# OPERON_HARNESS_PROFILE, OPERON_CRITIC, OPERON_GROUNDER, OPERON_BESTOFN_N, OPERON_BESTOFN_CONFIDENCE,
# OPERON_SITE_ADAPTERS, OPERON_{BROWSER,DESKTOP}_VERIFIER_{MODEL,THINKING},
# OPERON_{BROWSER,DESKTOP}_FALLBACK_MODEL and OPERON_BROWSER_FALLBACK_BACKEND; leftover
# values are ignored with a startup warning (OPERON_HARNESS_PROFILE=thin does not warn: CI sets it
# so benchmarks of revisions older than fc3d0ff run thin).

# Batch-mode browser runs that may step at the same time (KAN-81), each on its own
# isolated Chromium. 1 = today's behaviour (one shared browser, runs take turns).
# Observable (live view) and desktop runs always take turns. Extra starts get 429.
# OPERON_PARALLEL_RUNS=1

# Gemini's own content filter: `default` sends no safetySettings; `high_only` blocks only high-probability
# harm. Off by default; never touches Operon's safety gates or the Computer Use safety_decision confirmation.
# OPERON_GEMINI_SAFETY=default

# Wait for the screen to stop changing after each action instead of a fixed sleep
# (KAN-110). Samples small frames locally (no model call); off by default.
# OPERON_SETTLE_DETECT=off
# Benchmark runs only (KAN-169): `operon run` answers the model's own "require confirmation" pause yes
# (up to 10 per run) because nobody can click Resume. Trust-gate approvals are never answered. `on` enables.
# OPERON_AUTO_CONFIRM=off
# Longest a settle wait may run, in seconds (0.5 to 15).
# OPERON_SETTLE_MAX_S=3.0
# Give the model one line of text about what flashed past while the screen settled (a
# message that appeared and closed, a spinner still turning). Text only, no extra images,
# no model call; it also turns on the frame sampling above (KAN-111). Off by default.
# OPERON_CHANGE_NOTE=off
# Windows desktop: if another program's window took focus while the model was deciding, skip the first
# action after each screenshot and re-observe instead of typing or clicking into it (KAN-92). Off by default.
# OPERON_FOCUS_GUARD=off
# Windows desktop: make the process per-monitor-v2 DPI aware before pyautogui is imported (pyautogui otherwise
# locks it at system-aware, so clicks drift on displays whose scale differs from the system's) (KAN-90).
# Off by default.
# OPERON_DPI_AWARE=off
# Ask the model to say what it expects to see after each action (one line of text), compare
# that with how much of the screen changed, and tell it on the next step when they differ.
# Text only, no model call, never changes a result or an action. Off by default (KAN-116).
# OPERON_EXPECT_CHECK=off
# A cheaper model writes a short plan once at task start, sent to the acting model as a
# note on its first step. One extra text-only call per run, no re-planning. Off by
# default (KAN-112); the model is OPERON_PLANNER_MODEL.
# OPERON_PLANNER=off
# OPERON_PLANNER_MODEL=gemini-3.5-flash-lite
# A running note for long tasks, built by the loop with no model call: the task, the plan
# steps (when OPERON_PLANNER ran), the last few actions with their outcome, and the step
# count, sent as a note with every step (KAN-102). Off by default.
# OPERON_TASK_NOTE=off
# How many recent actions the note lists (1 to 50).
# OPERON_TASK_NOTE_MAX_ITEMS=8
# Checkpoint and resume (KAN-80): when the API starts, runs the last process left running or
# waiting are marked "interrupted". Nothing resumes by itself: POST /run/{id}/resume-interrupted
# or `operon resume <run_id>` continues one from the current screen. Off by default.
# OPERON_CHECKPOINTS=off

# ── Tools (RFC 0002) ─────────────────────────────────────────────────────────
# Tools the model may call next to its screen actions (computer_use backend only):
# off | on (default: read_file, list_dir, write_file, http_get) | all (adds run_shell)
# | a comma list of tool names. File tools obey the file guard (OPERON_ALLOWED_FILE_ROOTS);
# with the trust gate on, run_shell always needs approval.
# OPERON_TOOLS=on

# ── Experimental (RFC 0003) ───────────────────────────────────────────────────
# A repeated action counts as progress only if its after-screen
# differs from the screens the same action produced earlier in the run. It only affects the
# progress trace and the efficiency metric; it never stops the loop.
# OPERON_PROGRESS_REVISIT=off

# ── Experimental (KAN-82) ─────────────────────────────────────────────────────
# Zoom before clicking: refine the model's click on a crop around it, in one extra
# model call (computer_use backends). dense (default: only screens whose longer side is at
# least OPERON_ZOOM_MIN_SIDE px, 2000 by default, so ordinary 1920x1080 screens are untouched;
# ScreenSpot-Pro 50% -> 68%) | off (never) | always (every click, for measuring).
# The benchmark workflows pass off.
# OPERON_ZOOM=dense
# OPERON_ZOOM_MIN_SIDE=2000
# The crop is 1/factor of the screen each way (1.5 to 6).
# OPERON_ZOOM_FACTOR=2.0

# Pre-execution deny/confirm policy gate: on (default) | off
# On pauses for approval before the built-in high-risk actions (OPERON_TRUST_CONFIRM).
# The benchmarks set it to off so their scores stay comparable.
# OPERON_TRUST_GATE=on
# Comma-separated phrases that BLOCK an action (run pauses for a human).
# OPERON_TRUST_DENY=
# Comma-separated phrases that require human approval before running.
# Defaults to a conservative high-risk set when the gate is on and unset.
# OPERON_TRUST_CONFIRM=
# Comma-separated domains (subdomains included). When set, navigation is
# restricted to these domains and any other URL is denied (fail-closed).
# OPERON_TRUST_ALLOW_DOMAINS=
# Named risk categories (experimental, default off): a short button label or the model's
# stated intent that names a payment, send, delete, account or install action needs approval.
# OPERON_TRUST_CATEGORIES=off
# Comma-separated categories to enforce when the above is on (default: all five).
# OPERON_TRUST_CATEGORY_LIST=payment,send,delete,account,install
# Secrets vault (experimental, default off): the model types {{secret:NAME}} and the executor
# fills in the value you stored with `operon secrets set NAME`. See docs/secrets.md.
# OPERON_SECRETS=off
# Model API keys from the operating system's credential store (Windows Credential Manager;
# macOS Keychain or desktop Linux keystore when present). Store one with `operon keys set GEMINI_API_KEY`.
# Order: real environment, credential store, this .env, ~/.operon/operon.env. on | off
# OPERON_KEYRING=on
# Experimental (KAN-163): before a click that names no element, read the text under the
# click point from the screenshot with local OCR (no model call) and ask for approval when
# it matches a deny or confirm phrase. Needs: pip install -e ".[ocr]". off | on
# OPERON_CLICK_TEXT=off
# Permission mode for a run that does not pick one (`operon run --mode` and the API
# pick per run): ask (approve every action) | risky (default: the gate's confirm list) |
# auto (no approvals; deny rules and the domain allowlist still block).
# OPERON_PERMISSION_MODE=risky
# Lifetime in seconds of the short-lived /ws/stream tokens clients use (10..86400).
# OPERON_STREAM_TOKEN_TTL_S=600
# API address for `operon run --request` (default http://127.0.0.1:8080).
# OPERON_API_URL=http://127.0.0.1:8080

# File guard (always on): read_text / upload_file paths must be named in the
# task, sit inside the run directory, or fall under one of these
# comma-separated directories; any other path pauses the run for a human.
# OPERON_ALLOWED_FILE_ROOTS=

# ── HITL Webhook (optional) ───────────────────────────────────────────────────
# POST endpoint called when the agent pauses for human intervention.
# Payload: { event, run_id, intent, page_hint, message, url }
HITL_WEBHOOK_URL=

# ── Observability ─────────────────────────────────────────────────────────────
# Set to 1 to emit detailed step trace events to stdout (loop debugging).
# OPERON_TRACE=1

# ── Testing ───────────────────────────────────────────────────────────────────
# Skip display baseline and servo calibration in tests.
# OPERON_TEST_SAFE_MODE=false
# Re-raise bugs (AttributeError, NameError, AssertionError, ImportError) at the agent
# loop's recovery sites instead of carrying on. The offline test suite turns it on;
# off, each recovery is logged and counted in the run's state (recovered_errors).
# OPERON_STRICT_ERRORS=false
