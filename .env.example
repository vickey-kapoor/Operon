# ── Model keys ───────────────────────────────────────────────────────────────
# GEMINI_API_KEY is required: Gemini is the default model for browser and desktop runs.
# ANTHROPIC_API_KEY (below) is only for running Claude as a comparison model.
# Gemini API key (get one at https://aistudio.google.com/apikey). It runs the default
# browser and desktop backends (Gemini computer use) and the browser fallback. The JSON backends
# accept either name (GEMINI_API_KEY takes precedence); Gemini Computer Use reads
# GEMINI_API_KEY only.
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# ── Anthropic — Claude computer use as a comparison model (OPERON_*_BACKEND=claude_computer_use), or verifier provider = "anthropic" ──
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1/messages

# ── Auth & Security ───────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for the X-API-Key header.
#
# Unset = the server generates one key on first start and keeps it in
# .var/api-key (under OPERON_RUNTIME_ROOT). The benchmark harness reads
# that file, so local use needs no setup.
# API_KEYS=your-key-1,your-key-2
API_KEYS=

# Turn authentication off (only when API_KEYS is unset). This API can drive a
# real browser and a real desktop, so use it only on a throwaway machine.
OPERON_ALLOW_UNAUTHENTICATED=false

# Comma-separated list of allowed CORS origins (exact scheme://host:port). Empty = no
# origins allowed. Also gates browser connections to /ws/stream (any other Origin is
# refused; clients that send no Origin, and loopback same-origin pages, are allowed).
# Example: CORS_ORIGINS=http://localhost:3000,https://myapp.com
CORS_ORIGINS=

# Extra host names this API answers to, comma-separated. Loopback names
# (localhost, 127.0.0.1, ::1) are always allowed; a request for any other Host is
# refused with 400, which stops web pages from reaching the API by DNS rebinding.
# Example: OPERON_ALLOWED_HOSTS=operon.internal
OPERON_ALLOWED_HOSTS=

# ── Browser ───────────────────────────────────────────────────────────────────
# Run Chromium headless. Set to "false" to watch the browser window.
BROWSER_HEADLESS=true
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# ── Persistence ───────────────────────────────────────────────────────────────
# Local generated artifact roots. Leave unset to use the .var/... defaults.
# OPERON_RUNTIME_ROOT=.var
# OPERON_RUNS_ROOT=.var/runs
# OPERON_BROWSER_ARTIFACTS_ROOT=.var/browser-artifacts
# OPERON_DESKTOP_ARTIFACTS_ROOT=.var/desktop-artifacts
# OPERON_TEST_ARTIFACTS_ROOT=.var/test-artifacts
# Days of run directories kept by the startup retention sweep; -1 disables it.
# OPERON_RUNS_RETAIN_DAYS=14

# ── Vertex AI (optional — alternative to a Gemini API key) ───────────────────
# Set OPERON_USE_VERTEX=true to use Application Default Credentials instead.
# OPERON_USE_VERTEX=false
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# ── Model selection ───────────────────────────────────────────────────────────
# Global Gemini model default (used when no mode-specific model is set).
GEMINI_MODEL=gemini-2.5-flash

# Desktop loop — backend: computer_use (Gemini computer use, the default) | json (older Gemini JSON path) | claude_computer_use (comparison model, needs ANTHROPIC_API_KEY) | model (experimental)
# Verifier provider: gemini | anthropic
OPERON_DESKTOP_BACKEND=computer_use
# OPERON_DESKTOP_CLAUDE_MODEL=claude-opus-5-5
# OPERON_DESKTOP_CLAUDE_EFFORT=low   # low | medium | high | xhigh | max
# OPERON_DESKTOP_MODEL=gemini-2.5-flash   # for the json backend
# For OPERON_DESKTOP_BACKEND=computer_use use a computer-use model (unset = gemini-3.5-flash),
# with this Gemini 3 thinking level (minimal | low | medium | high; ignored on Gemini 2.x; empty = model default).
# OPERON_DESKTOP_THINKING=low
OPERON_DESKTOP_FALLBACK_MODEL=gemini-2.5-flash
# Step critic (full harness). With VERIFIER_PROVIDER=anthropic set a Claude model (unset = claude-sonnet-5-5).
OPERON_DESKTOP_VERIFIER_MODEL=gemini-3.5-flash
OPERON_DESKTOP_VERIFIER_PROVIDER=gemini
OPERON_DESKTOP_VERIFIER_THINKING=low

# Browser loop — backend: computer_use | claude_computer_use | json | model (experimental)
# Verifier provider: gemini | anthropic
# Unset = computer_use (Gemini, the default model); claude_computer_use runs Claude as a comparison model
# OPERON_BROWSER_BACKEND=claude_computer_use
OPERON_BROWSER_MODEL=gemini-3.5-flash
# Thinking: a level (minimal, low, high) on Gemini 3, a token budget (0 = off) on Gemini 2.5; empty = model default
OPERON_BROWSER_THINKING=low
# Claude computer use, a comparison model (needs ANTHROPIC_API_KEY; full harness only: falls back to the Gemini JSON backend on errors)
# OPERON_BROWSER_CLAUDE_MODEL=claude-opus-5-5
# OPERON_BROWSER_CLAUDE_EFFORT=low   # low | medium | high | xhigh | max
# Experimental: let Claude zoom into part of the screenshot (browser and desktop).
# The backend answers each zoom with a full-resolution crop; up to 3 per step.
# OPERON_CLAUDE_ZOOM=false
OPERON_BROWSER_FALLBACK_BACKEND=json
OPERON_BROWSER_FALLBACK_MODEL=gemini-2.5-flash
OPERON_BROWSER_VERIFIER_MODEL=gemini-3.5-flash
OPERON_BROWSER_VERIFIER_PROVIDER=gemini
OPERON_BROWSER_VERIFIER_THINKING=low

# Harness profile: thin | full. claude_computer_use defaults to thin, Gemini computer_use
# (browser and desktop) to full. thin runs the model's actions as chosen with no rules or
# retries in between, sends failures back to the model as tool results, and has no per-step
# Gemini verifier. Claude's "done" is checked once with Claude at the end; Gemini's own
# "done" ends the run unchecked (the benchmark graders decide). Safety gates stay on.
# json backends always run full.
# OPERON_HARNESS_PROFILE=thin
# Thin harness completion check model (unset = the acting Claude model). A cheaper
# model such as claude-sonnet-5-5 cuts the check's cost; benchmark before switching.
# OPERON_FINAL_CHECK_MODEL=

# ── Cross-model benchmark (experimental, off by default) ──────────────────────
# OPERON_BROWSER_BACKEND=model / OPERON_DESKTOP_BACKEND=model runs the registry profile
# named here (evals/models.yaml) through the model adapter: the thin harness, where the
# model's own "done" ends the run (the benchmark graders decide success), unless
# OPERON_HARNESS_PROFILE=full puts the rules, guards, critic and recovery around it.
# OPERON_MODEL_PROFILE=qwen3-vl-32b
# Full harness step critic: same = the acting model judges each step (so "GPT full" is not
# judged by Gemini); unset = the OPERON_*_VERIFIER_* critic.
# OPERON_CRITIC=same
# Registry file (unset = evals/models.yaml in the repo).
# OPERON_MODEL_REGISTRY=evals/models.yaml
# OpenAI computer use (profiles with adapter: openai_native).
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE_URL=https://api.openai.com/v1/responses
# Default endpoint and key for openai_compat profiles (vLLM's OpenAI-compatible server).
# OPENWEIGHT_BASE_URL=https://your-gpu-vm:8000/v1
# OPENWEIGHT_API_KEY=your-vllm-api-key
# Benchmark mode for claude_computer_use: claude (default) checks "done" with Claude;
# own takes the model's own "done", as backend=model always does.
# OPERON_COMPLETION_CHECK=claude

# ── Experimental (RFC 0001) ───────────────────────────────────────────────────
# Sample N candidate actions at uncertain steps, execute the best-scored one.
# 1 disables (default).
# OPERON_BESTOFN_N=1
# Only sample when step confidence is below this ceiling.
# OPERON_BESTOFN_CONFIDENCE=1.0

# Grounder backend: deterministic (default) | snap
# OPERON_GROUNDER=deterministic

# Built-in site adapters to load (comma-separated: wikipedia, github), or "all".
# Unset = none; search URLs fall back to <base>/search?q=<query>.
# OPERON_SITE_ADAPTERS=

# Pre-execution deny/confirm policy gate: on (default) | off
# On pauses for approval before the built-in high-risk actions (OPERON_TRUST_CONFIRM).
# The benchmarks set it to off so their scores stay comparable.
# OPERON_TRUST_GATE=on
# Comma-separated phrases that BLOCK an action (run pauses for a human).
# OPERON_TRUST_DENY=
# Comma-separated phrases that require human approval before running.
# Defaults to a conservative high-risk set when the gate is on and unset.
# OPERON_TRUST_CONFIRM=
# Comma-separated domains (subdomains included). When set, navigation is
# restricted to these domains and any other URL is denied (fail-closed).
# OPERON_TRUST_ALLOW_DOMAINS=

# File guard (always on): read_text / upload_file paths must be named in the
# task, sit inside the run directory, or fall under one of these
# comma-separated directories; any other path pauses the run for a human.
# OPERON_ALLOWED_FILE_ROOTS=

# ── HITL Webhook (optional) ───────────────────────────────────────────────────
# POST endpoint called when the agent pauses for human intervention.
# Payload: { event, run_id, intent, page_hint, message, url }
HITL_WEBHOOK_URL=

# ── Observability ─────────────────────────────────────────────────────────────
# Set to 1 to emit detailed step trace events to stdout (loop debugging).
# OPERON_TRACE=1

# ── Testing ───────────────────────────────────────────────────────────────────
# Skip display baseline and servo calibration in tests.
# OPERON_TEST_SAFE_MODE=false
